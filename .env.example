# WorkDo 登入資訊
WORKDO_EMAIL=your_email@example.com
WORKDO_PASSWORD=your_password

# 打卡時間設定 (24小時制 HH:MM)
CLOCK_IN_TIME=09:00
CLOCK_OUT_TIME=18:00

# 工作日設定 (1=週一, 2=週二, 3=週三, 4=週四, 5=週五, 6=週六, 7=週日)
WORKDAYS=1,2,3,4,5

# 彈性下班：若上班打卡晚於設定時間，下班時間按延遲分鐘數等比例順延（提早不提前）
ENABLE_FLEXIBLE_CLOCK_OUT=true

# GPS 打卡地點：台北市政府
# 台北市政大樓經緯度 (經度 X: 121.564451, 緯度 Y: 25.037517)
GPS_LOCATION="POINT (121.564451 25.037517)"
GPS_PLACE="台北市信義區市府路1號"

# WorkDo Tenant ID（預設為 aa6pd97f，登入時會自動嘗試從帳號更新）
TENANT_ID=aa6pd97f

# 假日日曆 iCal URL（預設使用 WorkDo 公司行事曆或台灣國定假日）
HOLIDAY_CALENDAR_URL=https://www.workdo.co/ical/6f0baf113c1f4f7088920d3ad32d5d543
ENABLE_HOLIDAY_CHECK=true

# 是否自動補送缺卡紀錄
ENABLE_MISSING_PUNCH_SUPPLEMENT=true

# 通知設定 (選填：Telegram / LINE / Discord / Webhook)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
LINE_NOTIFY_TOKEN=
