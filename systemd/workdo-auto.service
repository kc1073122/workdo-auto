[Unit]
Description=WorkDo Auto Punch Daemon Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/workdo-auto
ExecStart=%h/workdo-auto/venv/bin/python main.py daemon
Restart=always
RestartSec=30
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
