[Unit]
Description=WorkDo Clock-In Service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/workdo-auto
ExecStart=%h/workdo-auto/venv/bin/python main.py punch-in
StandardOutput=append:%h/workdo-auto/logs/systemd.log
StandardError=append:%h/workdo-auto/logs/systemd.log
